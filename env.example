# Copy this file to .env and fill in values as needed.

# App
APP_TITLE=AI CloudOps
DEFAULT_WEB_URL=http://3.110.30.49:10001/

# SMTP Email (recommended to use a provider like SES/SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_username@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_username@gmail.com

# AWS (prefer using AWS_PROFILE or SSO; these are optional)
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default

# S3 defaults
S3_DEFAULT_BUCKET=myprojectbasket
